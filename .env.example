# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_ENDPOINT=vertex   (auto: AQ. keys use Vertex AI, AIza keys use AI Studio)
ELEVENLABS_STT_MODEL=scribe_v2
