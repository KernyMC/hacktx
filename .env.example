PORT=8080
# Optional voice overrides, e.g. VOICE_CUTE=<elevenlabs voice id>

# Meta Model API (Muse): group plans and the village chronicle. https://dev.meta.ai
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
